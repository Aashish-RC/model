# ==============================================================================
# Model Workspace Root .gitignore
# Repository: https://github.com/Aashish-RC/model.git
# ==============================================================================

# ------------------------------------------------------------------------------
# Clones & External Reference Repositories
# ------------------------------------------------------------------------------
clones/

# ------------------------------------------------------------------------------
# Codebase Exclusions (Tests, UI Dashboard, Cookbooks, CI & Infra)
# ------------------------------------------------------------------------------
codebase/tests/
codebase/ui/
codebase/cookbook/
codebase/helm/
codebase/terraform/
codebase/.github/
codebase/.circleci/
codebase/.devcontainer/
codebase/.githooks/
codebase/vscode-extension/
codebase/examples/
codebase/docker/

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk
*Zone.Identifier

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# IDEs and Editors
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (IntelliJ, GoLand, PyCharm, etc.)
.idea/
*.iws
*.iml
*.ipr
out/

# Other Editors
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
*.env
!*.env.example
!*.env.template
secrets.toml
credentials.json
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# Logs & Diagnostics
# ------------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# Temporary & Cache Directories
# ------------------------------------------------------------------------------
tmp/
temp/
.cache/
.temp/

# ------------------------------------------------------------------------------
# Compiled Binaries & Executables
# ------------------------------------------------------------------------------
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/
build/
out/
target/

# ------------------------------------------------------------------------------
# Go Artifacts
# ------------------------------------------------------------------------------
*.test
*.out
/gateway

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/

# ------------------------------------------------------------------------------
# Node & Web Artifacts
# ------------------------------------------------------------------------------
node_modules/
.next/
.nuxt/
.turbo/
